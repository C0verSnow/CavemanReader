{
  "name": "caveman-reader",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "dist-electron/electron/main.js",
  "scripts": {
    "dev": "npm run build:electron && concurrently -k \"vite --host 127.0.0.1\" \"wait-on http://127.0.0.1:5173 && electron . --dev\"",
    "build:electron": "tsc -p tsconfig.electron.json",
    "build": "npm run typecheck && vite build && npm run build:electron",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.electron.json --noEmit",
    "start": "electron .",
    "test": "playwright test",
    "build:web": "vite build",
    "package:desktop": "npm run build && electron-builder --publish never",
    "mobile:prepare": "node scripts/prepare-mobile.mjs"
  },
  "dependencies": {
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "@capacitor/core": "8.5.3",
    "@capacitor/android": "8.5.3",
    "@capacitor/ios": "8.5.3",
    "@capacitor/inappbrowser": "4.0.4"
  },
  "devDependencies": {
    "@playwright/test": "1.64.0",
    "@types/node": "26.6.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "concurrently": "10.0.6",
    "electron": "44.7.0",
    "typescript": "7.0.2",
    "vite": "8.3.4",
    "wait-on": "9.5.1",
    "@capacitor/cli": "8.5.3",
    "electron-builder": "26.15.3"
  },
  "description": "A personal book library with an in-app browser",
  "author": "C0verSnow",
  "license": "UNLICENSED"
}
